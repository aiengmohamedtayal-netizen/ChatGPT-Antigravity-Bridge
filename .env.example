# ===================================================
# ChatGPT × Antigravity Bridge Configuration
# ===================================================

# Application Environment (development, production, testing)
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Master Security Secret Key (Used for secret encryption and key signing)
# Generate a strong 32-byte urlsafe base64 key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BRIDGE_SECRET_KEY=dev-secret-key-please-change-in-production-32-chars-min!

# Database Configuration (SQLite WAL mode by default)
DATABASE_URL=sqlite:///./bridge_data.db

# Antigravity Settings
# Provider options: antigravity, simulated, claude_code, gemini_cli
DEFAULT_AGENT_PROVIDER=antigravity
# Leave empty to auto-detect ~/.gemini/antigravity on your platform, or specify custom path:
# ANTIGRAVITY_AGENTAPI_PATH=C:\Users\<username>\.gemini\antigravity\bin\agentapi.bat
# ANTIGRAVITY_BRAIN_DIR=C:\Users\<username>\.gemini\antigravity\brain
ANTIGRAVITY_LANGUAGE_SERVER_PORT=58045

# Rate Limiting
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_TASK_CREATE=30/minute

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGINS=*

# Optional Outbound OpenAI API Key (For Bridge-side Architect decomposition)
OPENAI_API_KEY=
